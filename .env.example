# Copy this file to .env (repo root) and fill in whichever key(s) you have.
# .env is git-ignored -- never commit real key values.
#
# Priority used by tools/image_generation/generate_anatomy_image.py when
# --provider is not specified: Gemini first, then OpenAI.

# Gemini API key (https://ai.google.dev/). Either name works; the SDK and
# our provider both check GEMINI_API_KEY first, then GOOGLE_API_KEY.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# OpenAI API key (https://platform.openai.com/).
OPENAI_API_KEY=

# Optional: override the default model id for either provider without
# editing code. Re-check current model names against each vendor's docs
# before setting these -- image-model names change over time.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-2
